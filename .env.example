# Database
DATABASE_URL=postgresql://finance_user:finance_pass@db:5432/finance_db

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Google Cloud Speech-to-Text API (для распознавания голоса)
# Получить: https://console.cloud.google.com/apis/credentials
GOOGLE_API_KEY=your_google_api_key_here

# Anthropic Claude API (для парсинга текста в транзакцию)
# Получить: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Dev Mode (true для разработки без Telegram auth)
DEV_MODE=true
