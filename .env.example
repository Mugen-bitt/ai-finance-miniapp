# Database
DATABASE_URL=postgresql://finance_user:finance_pass@db:5432/finance_db

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# OpenAI API (для Whisper STT и GPT парсинга)
# Получить: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Dev Mode (true для разработки без Telegram auth)
DEV_MODE=true
